# ==============================================================================
*.sql
*/*.sql
**/*.sql
!/database/schema.sql
!database/schema.sql
*.sql.gz
*.sql.zip
*.dump
*.dump.*
*.bak
*.backup
*dump*.sql
*backup*.sql

