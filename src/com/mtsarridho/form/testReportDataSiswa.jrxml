	<parameter name="tingkat" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT
     tb_siswa.`nisn` AS tb_siswa_nisn,
     tb_siswa.`nama` AS tb_siswa_nama,
     tb_siswa.`jenis_kelamin` AS tb_siswa_jenis_kelamin,
     tb_siswa.`tempat_lahir` AS tb_siswa_tempat_lahir,
     tb_siswa.`tanggal_lahir` AS tb_siswa_tanggal_lahir,
     tb_siswa.`tingkat` AS tb_siswa_tingkat
FROM
     `tb_siswa` tb_siswa
WHERE
($P{tingkat} IS NULL or  $P{tingkat} = "" or tb_siswa.`tingkat` = $P{tingkat})]]>
	</queryString>
	<field name="tb_siswa_nisn" class="java.lang.String"/>
