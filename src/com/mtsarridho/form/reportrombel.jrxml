	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<queryString language="SQL">
		<![CDATA[SELECT 
r.id_rombel,
  r.nama_rombel, 
  g.nama AS nama_guru, 
  r.tingkat_kelas, 
  r.tahun_ajaran,
  s.nama AS nama_siswa, 
  s.nisn, 
  s.tingkat
FROM 
  tb_rombel r
JOIN 
  tb_guru g ON r.wali_kelas = g.nik
JOIN 
  tb_rombel_siswa rs ON r.id_rombel = rs.id_rombel
JOIN 
  tb_siswa s ON rs.nisn = s.nisn]]>
	</queryString>
