	<queryString>
		<![CDATA[SELECT
     tb_guru.`nik` AS tb_guru_nik,
     tb_guru.`nama` AS tb_guru_nama,
     tb_guru.`jenis_kelamin` AS tb_guru_jenis_kelamin
